# ============================================================
# Polymarket gRPC — Environment Configuration Template
# Copy to .env and fill in your values before running locally.
# NEVER commit .env to version control!
# ============================================================

# Server
SERVER_HOST=0.0.0.0
GRPC_PORT=50051
HTTP_PORT=8080
SHUTDOWN_TIMEOUT=30s
MAX_CONNECTIONS=1000

# TLS (set to true in production)
TLS_ENABLED=false
CERT_FILE=certs/server.crt
KEY_FILE=certs/server.key

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=polymarket
DB_USER=polymarket
DB_PASSWORD=change_me_in_production
DB_SSL_MODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# JWT — MUST CHANGE IN PRODUCTION
JWT_SECRET=polymarket-super-secret-key-change-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
JWT_ISSUER=polymarket-api

# Inter-service addresses (if running as separate processes)
USER_SERVICE_ADDR=localhost:50051
MARKET_SERVICE_ADDR=localhost:50052
ORDER_SERVICE_ADDR=localhost:50053
WALLET_SERVICE_ADDR=localhost:50054

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
