---
title: Trading Market Platform — Architecture & Flow Diagrams
---

%% ═══════════════════════════════════════════════════
%%  DIAGRAM 1 — SYSTEM ARCHITECTURE
%% ═══════════════════════════════════════════════════

flowchart TB
    subgraph CLIENT["🖥️  Windows Desktop Client  (C# / WinForms / .NET 8)"]
        direction TB
        LP["LoginForm\n• Email / Password\n• Registration"]
        MF["MainForm Dashboard\n• Market status bar\n• Live price grid\n• Order entry panel\n• Order blotter"]
        GC["GrpcClient.cs\n• MarketServiceClient\n• OrderServiceClient\n• TraderServiceClient"]
        LP -->|"Auth success + JWT"| MF
        MF <-->|"calls"| GC
    end

    subgraph GRPC["gRPC Channel  (HTTP/2 · Port 50051 · Protocol Buffers)"]
        direction LR
        UNI["Unary RPCs\n(request/response)"]
        STREAM["Server Streaming RPCs\n(SubscribePrices / SubscribeTrades)"]
    end

    subgraph SERVER["⚙️  Go gRPC Server"]
        direction TB
        MS["MarketService\nGetMarketStatus\nListSecurities\nGetPrice\nSubscribePrices ▶\nSubscribeTrades ▶"]
        OS["OrderService\nPlaceOrder\nCancelOrder\nGetOrder\nListOrders"]
        TS["TraderService\nRegisterTrader\nLogin\nGetTrader\nDeposit"]

        subgraph DOMAIN["Internal Domain"]
            ENG["market.Engine\n• Price book\n• Circuit breaker\n• Trading hours\n• Pub-Sub channels"]
            ORD["orders.Store\n• Order book (bids/asks)\n• Matching engine\n• Trade generation"]
            AUTH["auth.Service\n• bcrypt passwords\n• JWT generation\n• Balance management"]
            REG["securities.Registry\n• Listed securities\n• Symbol catalogue"]
        end

        MS <--> ENG
        MS <--> REG
        OS <--> ORD
        OS <--> ENG
        TS <--> AUTH
    end

    GC <-->|"gRPC calls"| GRPC
    GRPC <-->|"gRPC calls"| SERVER

    style CLIENT fill:#0d1b2a,color:#e0e0e0,stroke:#1e3a5f
    style GRPC   fill:#1a1a2e,color:#e0e0e0,stroke:#533483
    style SERVER fill:#0f2027,color:#e0e0e0,stroke:#1b4332
    style DOMAIN fill:#1b2838,color:#e0e0e0,stroke:#2a475e

