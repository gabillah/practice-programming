# CFD Pipe Flow Expert — Environment Configuration
# Copy this file to .env and adjust values for your environment

# Application
APP_NAME="CFD Pipe Flow Expert"
VERSION="1.0.0"
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000

# Database (choose one)
# Development (SQLite — zero setup):
DATABASE_URL=sqlite+aiosqlite:///./cfd_pipe_flow.db
# Production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://cfd_user:cfd_pass@localhost:5432/cfd_db

# CORS — comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/cfd_app.log

# Solver limits
MAX_SOLVER_ITERATIONS=500
DEFAULT_SOLVER_TOLERANCE=1e-6
MAX_NETWORK_NODES=2000
MAX_NETWORK_PIPES=5000
