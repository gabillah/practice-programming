# FlowSim CFD — Backend Environment Configuration
# Copy to .env and edit for your environment

DATABASE_URL=sqlite+aiosqlite:///./flowsim.db
SECRET_KEY=change-this-to-a-random-256-bit-key-in-production
DEBUG=false
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Solver limits
SOLVER_MAX_ITERATIONS=1000
SOLVER_CONVERGENCE_TOLERANCE=1e-6
SOLVER_RELAXATION_FACTOR=0.8
SOLVER_MAX_PIPES=500
SOLVER_MAX_NODES=250

# CFD defaults
DEFAULT_FLUID=water_20
DEFAULT_TEMPERATURE_C=20.0
DEFAULT_PRESSURE_PA=101325.0
GRAVITY_MS2=9.80665
